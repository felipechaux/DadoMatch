# frozen_string_literal: true

require_relative "release_notes"

default_platform(:android)

PROJECT_ROOT = File.expand_path("..", __dir__)
VERSIONS_FILE = File.join(PROJECT_ROOT, "androidCoreVersions.gradle")
PLAY_JSON_KEY = File.join(PROJECT_ROOT, "app/play-service-account.json")
# CI clones the shared KMP module next to this repo; locally it is the sibling checkout
SHARED_DIR = File.expand_path("../dado-match-shared", PROJECT_ROOT)
# Absolute: __dir__ is relative in a Fastfile and fastlane changes the working
# directory between steps
PLAY_METADATA = File.join(PROJECT_ROOT, "fastlane", "metadata", "android")

platform :android do
  # ──────────────────────────────────────────
  # Build a signed release AAB
  # ──────────────────────────────────────────
  desc "Build a signed release AAB"
  lane :build do
    gradle(
      task: "clean bundle",
      build_type: "Release",
      project_dir: "./",
      print_command: true,
      properties: {
        "appFlavor" => ENV["APP_FLAVOR"] || "production"
      }
    )
  end

  # ──────────────────────────────────────────
  # Upload to Internal Testing track
  # ──────────────────────────────────────────
  desc "Upload to Google Play Internal Testing"
  lane :internal do |options|
    build  # always build fresh before uploading
    project_root = File.expand_path("..", __dir__)
    # release passes with_changelog: the "What's new" files written for this versionCode
    with_changelog = options[:with_changelog] == true
    upload_to_play_store(
      track: "internal",
      package_name: "com.chauxdevapps.dadomatch",
      aab: File.join(project_root, "app/build/outputs/bundle/release/app-release.aab"),
      json_key: File.join(project_root, "app/play-service-account.json"),
      metadata_path: PLAY_METADATA,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: !with_changelog,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  # ──────────────────────────────────────────
  # Upload to Alpha (Closed Testing) track
  # ──────────────────────────────────────────
  desc "Upload to Google Play Closed Testing (Alpha)"
  lane :beta do
    build  # always build fresh before uploading
    project_root = File.expand_path("..", __dir__)
    upload_to_play_store(
      track: "alpha",
      package_name: "com.chauxdevapps.dadomatch",
      aab: File.join(project_root, "app/build/outputs/bundle/release/app-release.aab"),
      json_key: File.join(project_root, "app/play-service-account.json"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  # ──────────────────────────────────────────
  # Promote Internal → Production
  # ──────────────────────────────────────────
  desc "Promote Internal Testing release to Production"
  lane :production do
    project_root = File.expand_path("..", __dir__)
    # Promotion copies the Internal release with the notes uploaded by `release`;
    # show them once more before they reach every user
    tag = "v#{read_app_version('versionName')}"
    if File.exist?(ReleaseNotes.path_for(tag))
      ReleaseNotes.review!(tag, purpose: "promote to Production (already attached to the Internal release)")
    else
      UI.important("No release notes saved for #{tag}; Production will use whatever the Internal release has")
      UI.user_error!("Promotion cancelled") unless UI.confirm("Promote anyway?")
    end
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      json_key: File.join(project_root, "app/play-service-account.json"),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  # ──────────────────────────────────────────
  # Bump version, upload to Internal Testing, then commit + tag
  #   fastlane android release bump:patch|minor|major
  # ──────────────────────────────────────────
  desc "Bump versionName (bump:patch|minor|major) + versionCode, upload to Internal Testing and tag vX.Y.Z"
  lane :release do |options|
    bump = (options[:bump] || "patch").to_s
    UI.user_error!("bump must be patch, minor or major") unless %w[patch minor major].include?(bump)

    ensure_git_branch(branch: "main")
    ensure_git_status_clean
    git_pull
    ensure_shared_ready

    version = read_app_version("versionName")
    code = read_app_version("versionCode").to_i
    new_version = next_version(version, bump)
    # Never reuse a versionCode Google Play already has on any track
    play_codes = %w[internal alpha beta production].flat_map do |track|
      google_play_track_version_codes(track: track, json_key: PLAY_JSON_KEY)
    rescue StandardError
      [] # track never used
    end
    new_code = ([code] + play_codes).max + 1
    tag = "v#{new_version}"
    UI.user_error!("Tag #{tag} already exists") if git_tag_exists(tag: tag)
    UI.important("Releasing #{version} (#{code}) → #{new_version} (#{new_code})")

    write_app_version("versionName", "\"#{version}\"", "\"#{new_version}\"")
    write_app_version("versionCode", code, new_code)

    # Store "What's new", written from the commits since the previous release
    ReleaseNotes.prepare(tag, platform: "android") do
      ReleaseNotes.collect_commits(
        app_repo: PROJECT_ROOT,
        shared_repo: SHARED_DIR,
        previous_tag: ReleaseNotes.previous_tag(PROJECT_ROOT)
      )
    end
    notes = ReleaseNotes.review!(tag, purpose: "upload to Internal Testing")
    changelog_files = write_play_changelogs(notes, new_code)

    internal(with_changelog: true)

    shared_sha = sh("git -C '#{SHARED_DIR}' rev-parse HEAD", log: false).strip
    git_add(path: [ReleaseNotes.path_for(tag)] + changelog_files)
    git_commit(
      path: [VERSIONS_FILE, ReleaseNotes.path_for(tag)] + changelog_files,
      message: "chore(release): #{tag} (versionCode #{new_code})"
    )
    # The Shared trailer lets the next release list only the shared commits after this one
    add_git_tag(tag: tag, message: "Release #{tag} (versionCode #{new_code})\n\n#{ReleaseNotes.tag_trailer_line(shared_sha)}")
    push_to_git_remote(remote_branch: "main", tags: true)
    if system("which gh > /dev/null")
      sh("gh", "release", "create", tag, "--title", "Release #{tag}", "--notes", notes.fetch("en-US"))
    end
    UI.success("#{tag} (#{new_code}) uploaded to Internal Testing. Promote it with: make promote")
  end

  # ──────────────────────────────────────────
  # Preview the store notes the next release would get (nothing is uploaded)
  # ──────────────────────────────────────────
  desc "Preview the release notes for the next release (bump: saves them as the draft that release uploads)"
  lane :notes do |options|
    previous = ReleaseNotes.previous_tag(PROJECT_ROOT)
    commits = ReleaseNotes.collect_commits(app_repo: PROJECT_ROOT, shared_repo: SHARED_DIR, previous_tag: previous)
    UI.message("#{commits.size} user-facing commits since #{previous || 'the beginning'}")
    notes = ReleaseNotes.generate(platform: "android", commits: commits)
    notes.each { |lang, text| UI.message("[#{lang}] (#{text.length}/#{ReleaseNotes::MAX_CHARS})\n#{text}\n") }
    UI.message("Play listing languages: #{play_listing_languages.join(', ')}")

    if (bump = options[:bump])
      tag = "v#{next_version(read_app_version('versionName'), bump.to_s)}"
      draft = ReleaseNotes.draft_path_for(tag)
      FileUtils.mkdir_p(File.dirname(draft))
      File.write(draft, JSON.pretty_generate(notes) + "\n")
      UI.success("Draft for #{tag} saved to #{draft} — edit it if needed; `make release BUMP=#{bump}` will use it")
    end
  end

  error do |lane, _exception|
    # release calls internal, and a failure there is reported with lane :internal
    next unless %i[release internal].include?(lane)
    # A failed release must not leave a half-applied version bump behind
    reset_git_repo(force: true, files: [VERSIONS_FILE])
    ReleaseNotes.restore_drafts!(PROJECT_ROOT)
    sh("git -C '#{PROJECT_ROOT}' clean -fdq -- fastlane/metadata", log: false)
  end

  # ──────────────────────────────────────────
  # CI helper: load local.properties into ENV
  # ──────────────────────────────────────────
  before_all do
    # Load signing props from local.properties when not already set
    # (e.g. on a developer's machine; CI should inject ENV vars directly)
    props_file = File.join(Dir.pwd, "local.properties")
    if File.exist?(props_file)
      File.readlines(props_file).each do |line|
        next if line.strip.start_with?("#") || line.strip.empty?
        key, value = line.strip.split("=", 2)
        ENV[key] ||= value if key && value
      end
    end
  end
end

def read_app_version(key)
  value = File.read(VERSIONS_FILE)[/'#{key}':\s*"?([0-9.]+)"?/, 1]
  UI.user_error!("Could not read #{key} from #{VERSIONS_FILE}") unless value
  value
end

def write_app_version(key, from, to)
  versions = File.read(VERSIONS_FILE)
  File.write(VERSIONS_FILE, versions.sub("'#{key}': #{from}", "'#{key}': #{to}"))
end

def next_version(version, bump)
  parts = version.split(".").map(&:to_i)
  UI.user_error!("versionName #{version} is not X.Y.Z") unless parts.size == 3
  major, minor, patch = parts
  case bump
  when "major" then "#{major + 1}.0.0"
  when "minor" then "#{major}.#{minor + 1}.0"
  else "#{major}.#{minor}.#{patch + 1}"
  end
end

# The AAB embeds whatever the shared repo has checked out (includeBuild), so it
# must be the released code: main, clean and up to date
def ensure_shared_ready
  UI.user_error!("Shared repo not found at #{SHARED_DIR}") unless Dir.exist?(SHARED_DIR)
  branch = sh("git -C '#{SHARED_DIR}' rev-parse --abbrev-ref HEAD", log: false).strip
  UI.user_error!("dado-match-shared must be on main (is on #{branch})") unless branch == "main"
  dirty = sh("git -C '#{SHARED_DIR}' status --porcelain", log: false).strip
  UI.user_error!("dado-match-shared has uncommitted changes:\n#{dirty}") unless dirty.empty?
  sh("git -C '#{SHARED_DIR}' pull --ff-only", log: false)
end

# Google Play only accepts notes for languages in the store listing, so write
# the changelog file only for those; the rest stay in the release notes JSON
def write_play_changelogs(notes, version_code)
  listed = play_listing_languages
  skipped = notes.keys - listed
  UI.important("Not in the Play listing, kept only in the JSON: #{skipped.join(', ')}") unless skipped.empty?
  (notes.keys & listed).map do |lang|
    path = File.join(PLAY_METADATA, lang, "changelogs", "#{version_code}.txt")
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, notes[lang] + "\n")
    path
  end.tap { |files| UI.user_error!("No release notes language matches the Play listing (#{listed.join(', ')})") if files.empty? }
end

def play_listing_languages
  require "supply"
  Supply.config = FastlaneCore::Configuration.create(
    Supply::Options.available_options,
    { package_name: "com.chauxdevapps.dadomatch", json_key: PLAY_JSON_KEY }
  )
  client = Supply::Client.make_from_config
  client.begin_edit(package_name: "com.chauxdevapps.dadomatch")
  client.listings.map(&:language)
ensure
  client&.abort_current_edit
end
